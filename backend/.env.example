# ── Anthropic ────────────────────────────────────────────────────────────────
# Claude API key — get it from https://console.anthropic.com
ANTHROPIC_API_KEY=
# ── Ollama ───────────────────────────────────────────────────────────────────
# Local Ollama server (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Model to use (must be pulled: `ollama pull llama3`)
OLLAMA_MODEL=llama3

# ── ElevenLabs ───────────────────────────────────────────────────────────────
# ElevenLabs API key — get it from https://elevenlabs.io
ELEVENLABS_API_KEY=
# Voice IDs for Asian languages (find in ElevenLabs voice library)
ELEVENLABS_VOICE_KO=
ELEVENLABS_VOICE_JA=
ELEVENLABS_VOICE_ZH=

# ── Tavily Web Search ────────────────────────────────────────────────────────
# Tavily search API key — get it from https://tavily.com
TAVILY_API_KEY=

# ── Home Assistant ───────────────────────────────────────────────────────────
# Home Assistant base URL (local or Nabu Casa)
HASS_URL=http://homeassistant.local:8123
# Long-lived access token from HA → Profile → Security → Long-lived access tokens
HASS_TOKEN=

# ── Google Calendar ──────────────────────────────────────────────────────────
# Path to your OAuth2 credentials JSON downloaded from Google Cloud Console
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ── Browser ──────────────────────────────────────────────────────────────────
# Optional: full path to Brave browser executable
# Windows example: C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
# Mac example:     /Applications/Brave Browser.app/Contents/MacOS/Brave Browser
# Linux example:   /usr/bin/brave-browser
BRAVE_PATH=

# ── Piper TTS ────────────────────────────────────────────────────────────────
# Local folder where piper voice model files (.onnx + .json) are stored
# Download models from: https://huggingface.co/rhasspy/piper-voices
PIPER_MODELS_PATH=./piper_models
